ROLL_SCALE_API_URL=https://YOUR_PROJECT_REF.supabase.co/functions/v1/ingest-measurement
ROLL_SCALE_LOOKUP_URL=https://YOUR_PROJECT_REF.supabase.co/functions/v1/lookup-roll
ROLL_SCALE_DEVICE_TOKEN=replace-with-device-ingest-token
ROLL_SCALE_LOOKUP_TOKEN=replace-with-device-lookup-token
ROLL_SCALE_GATEWAY_ID=gateway-01
ROLL_SCALE_DEVICE_ID=gateway-01
ROLL_SCALE_STATION_ID=station-01
ROLL_SCALE_CAMERA_ID=camera-01

# Optional cloud recognition. Gemini mode sends exactly 1 full image per capture.
ROLL_SCALE_GEMINI_ENABLED=false
ROLL_SCALE_WEIGHT_ENGINE=local
# ROLL_SCALE_GEMINI_API_KEY=replace-with-google-ai-studio-key
ROLL_SCALE_GEMINI_MODEL=gemini-3.5-flash-lite
ROLL_SCALE_GEMINI_TIMEOUT=10.0

# ROLL_SCALE_DEVICE_ID is the legacy compatibility name for gateway_id.
# Browser media device IDs stay local and are never cloud identities.

# These values belong only in Supabase Edge Function secrets.
# Never put production Cloudinary credentials in the desktop environment.
CLOUDINARY_CLOUD_NAME=replace-with-cloud-name
CLOUDINARY_API_KEY=replace-with-api-key
CLOUDINARY_API_SECRET=replace-with-api-secret
